# =====================================================================
# Konfigurasi Lingkungan (Environment Configuration)
# SMKS SUKAPURA - Web & SPMB
# =====================================================================

# Pilihan Lingkungan: local / production
APP_ENV=local

# URL Dasar Website (termasuk protocol http/https dan port jika ada)
# Contoh Local: http://localhost:8000
# Contoh Prod : https://smksukapura.sch.id
APP_URL=http://localhost:8000

# =====================================================================
# Konfigurasi Database MySQL
# =====================================================================
# Local (XAMPP / Laragon / PHP built-in):
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASS=
# DB_NAME=db_sekolah

# Production (VPS / cPanel Hosting):
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=db_sekolah


# FONNTE_TOKEN=
# FONNTE_STATUS=1


# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=


BREVO_API_KEY=
